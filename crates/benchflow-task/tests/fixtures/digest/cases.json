      "tests/sub/__pycache__/deep/z.txt": "under __pycache__/\n",
      "solution/solve.sh": "#!/bin/bash\ntrue\n",
      "steps/step-1/instruction.md": "First.\n"
    }
  },
  "split-gitignore": {
    "about": "A split-layout task with its own .gitignore, which replaces Harbor's default ignores",
    "files": {
      ".gitignore": "# build output\n*.log\n!keep.log\nbuild/\n!environment/build/keep.txt\n/environment/cache/\ntests/**/fixture-*.tmp\n\\#hash.txt\ntrail.txt   \ndocs\nsolution/*.bak\n!solution/important.bak\n",
      "task.toml": "schema_version = \"1.4\"\n",
      "instruction.md": "Do it.\n",
      "environment/Dockerfile": "FROM ubuntu:24.04\n",
      "environment/run.log": "ignored\n",
      "environment/keep.log": "kept by !keep.log\n",
      "environment/build/out.bin": "ignored\n",
      "environment/build/keep.txt": "kept by a later ! pattern\n",
      "environment/build.txt": "kept: build/ matches folders\n",
      "environment/cache/c.txt": "ignored\n",
      "environment/sub/cache/c.txt": "kept: /environment/cache/ is anchored\n",
      "environment/#hash.txt": "ignored by the escaped #\n",
      "environment/trail.txt": "ignored: trailing spaces are stripped\n",
      "environment/docs/readme.md": "ignored\n",
      "environment/__pycache__/m.cpython-312.pyc": {
        "base64": "yw0NCgAAAAD/AIA="
      },
      "tests/test.sh": "#!/bin/bash\n",
      "tests/fixture-2.tmp": "ignored: **/ matches no folder too\n",
      "tests/a/b/fixture-1.tmp": "ignored\n",
      "tests/a/b/other.tmp": "kept\n",
      "solution/solve.sh": "#!/bin/bash\n",
      "solution/old.bak": "ignored\n",
      "solution/important.bak": "kept\n"
    }
  },
  "split-gitignore-crlf": {
    "about": "A .gitignore with Windows line endings reads the same",
    "files": {
      ".gitignore": "*.log\r\n!keep.log\r\n",
      "task.toml": "",
      "environment/a.log": "ignored\n",
      "environment/keep.log": "kept\n",
      "environment/__pycache__/x.pyc": "kept: no default ignores\n"
    }
  },
  "taskmd": {
