    "files": {
      "task.toml": "schema_version = \"1.4\"\n\n[task]\nname = \"acme/digest\"\n",
      "instruction.md": "Do it.\n",
      "README.md": "# acme/digest\n",
      "trajectory.json": "[]\n",
      "notes.md": "not published\n",
      "extra/ignored.txt": "not published\n",
      "environment/Dockerfile": "FROM ubuntu:24.04\nWORKDIR /app\n",
      "environment/data/table.csv": "a,b\r\n1,2\r\n",
      "environment/data/empty.txt": "",
      "environment/data/blob.bin": {
        "base64": ""
      },
      "environment/a.b/c": "dot\n",
      "environment/a/c": "slash\n",
      "environment/B.txt": "upper\n",
      "environment/a.txt": "lower\n",
      "environment/café.txt": "été ☃\n",
      "environment/keep.pyc.txt": "kept: *.pyc does not match it\n",
      "environment/__pycache__/m.cpython-312.pyc": {
        "base64": "yw0NCgAAAAD/AIA="
      },
      "environment/.DS_Store": "x",
      "environment/notes.txt~": "backup\n",
      "environment/.edit.swp": "swap\n",
      "environment/.edit.swo": "swap\n",
      "tests/test.sh": "#!/bin/bash\necho 1 > /logs/verifier/reward.txt\n",
      "tests/__pycache__/t.cpython-312.pyc": {
        "base64": "yw0NCgAAAAD/AIA="
