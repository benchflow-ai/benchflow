{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://benchflow.ai/schemas/benchflow-assessment-event.v1.schema.json",
  "title": "One append-only event for a hash-bound blinded pairwise assessment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "assessment_id",
    "event_id",
    "event_seq",
    "created_at",
    "kind",
    "actor",
    "idempotency_key",
    "expected_previous_event_sha256",
    "previous_event_sha256",
    "payload",
    "event_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "benchflow.assessment-event.v1"
    },
    "assessment_id": {
      "type": "string",
      "format": "uuid"
    },
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "event_seq": {
      "type": "integer",
      "minimum": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "kind": {
      "enum": [
        "assessment.created",
        "compute.released",
        "assignment.issued",
        "review.submitted",
        "review.corrected",
        "review.retracted",
        "label.reduced",
        "label.consumed",
        "label.withdrawn"
      ]
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "subject"
      ],
      "properties": {
        "role": {
          "enum": [
            "bridge",
            "collector",
            "reviewer",
            "reducer",
            "consumer",
            "operator"
          ]
        },
        "subject": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      }
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "expected_previous_event_sha256": {
      "$ref": "#/$defs/optionalDigest"
    },
    "previous_event_sha256": {
      "$ref": "#/$defs/optionalDigest"
    },
    "payload": {
      "type": "object"
    },
    "event_sha256": {
      "$ref": "#/$defs/digest"
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "optionalDigest": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "prefixedDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "uuid7": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[^\\u0000-\\u001f\\u007f]*\\S[^\\u0000-\\u001f\\u007f]*$"
    },
    "reviewer": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[^\\u0000-\\u001f\\u007f]*\\S[^\\u0000-\\u001f\\u007f]*$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^(?!\\.\\.?(/|$))(?!.*/\\.\\.?(/|$))[^/\\\\\\u0000-\\u001f\\u007f]+(/[^/\\\\\\u0000-\\u001f\\u007f]+)*$"
    },
    "locator": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^/[^\\u0000-\\u001f\\u007f]*$"
    },
    "count": {
      "type": "integer",
      "minimum": 0
    },
    "tags": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/name"
      }
    },
    "member": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "bytes"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "sha256": {
          "$ref": "#/$defs/digest"
        },
        "bytes": {
          "$ref": "#/$defs/count"
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "runtime_id",
        "role",
        "source"
      ],
      "properties": {
        "provider": {
          "$ref": "#/$defs/name"
        },
        "runtime_id": {
          "$ref": "#/$defs/text"
        },
        "role": {
          "enum": [
            "solver",
            "verifier",
            "shared"
          ]
        },
        "source": {
          "enum": [
            "result.sandbox_id",
            "declared"
          ]
        }
      }
    },
    "savedAttemptRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "attempt_id",
        "rollout_id",
        "task_digest",
        "result_sha256",
        "output_manifest_sha256",
        "result",
        "output",
        "review_artifact",
        "runtime_refs"
      ],
      "properties": {
        "schema_version": {
          "const": "benchflow.saved-attempt-ref.v1"
        },
        "attempt_id": {
          "$ref": "#/$defs/digest"
        },
        "rollout_id": {
          "$ref": "#/$defs/text"
        },
        "task_digest": {
          "$ref": "#/$defs/prefixedDigest"
        },
        "result_sha256": {
          "$ref": "#/$defs/digest"
        },
        "output_manifest_sha256": {
          "$ref": "#/$defs/digest"
        },
        "result": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "locator",
            "bytes"
          ],
          "properties": {
            "locator": {
              "$ref": "#/$defs/locator"
            },
            "bytes": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "output": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "locator",
            "members"
          ],
          "properties": {
            "kind": {
              "enum": [
                "directory",
                "file"
              ]
            },
            "locator": {
              "$ref": "#/$defs/locator"
            },
            "members": {
              "type": "array",
              "minItems": 1,
              "maxItems": 100000,
              "items": {
                "$ref": "#/$defs/member"
              }
            }
          }
        },
        "review_artifact": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sha256",
            "bytes",
            "locator"
          ],
          "properties": {
            "sha256": {
              "$ref": "#/$defs/digest"
            },
            "bytes": {
              "type": "integer",
              "minimum": 1
            },
            "locator": {
              "$ref": "#/$defs/locator"
            },
            "media_type": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[^\\u0000-\\u001f\\u007f]*\\S[^\\u0000-\\u001f\\u007f]*$"
            }
          }
        },
        "runtime_refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/runtime"
          }
        }
      }
    },
    "frozenFile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "sha256",
        "bytes",
        "locator"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000-\\u001f\\u007f]*\\S[^\\u0000-\\u001f\\u007f]*$"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000-\\u001f\\u007f]*\\S[^\\u0000-\\u001f\\u007f]*$"
        },
        "sha256": {
          "$ref": "#/$defs/digest"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        },
        "locator": {
          "$ref": "#/$defs/locator"
        }
      }
    },
    "collectorPin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "implementation",
        "commit",
        "sources"
      ],
      "properties": {
        "implementation": {
          "$ref": "#/$defs/name"
        },
        "commit": {
          "$ref": "#/$defs/commit"
        },
        "sources": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 64,
          "propertyNames": {
            "$ref": "#/$defs/relativePath"
          },
          "additionalProperties": {
            "$ref": "#/$defs/digest"
          }
        }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "runtime_id",
        "state",
        "observed_at",
        "observer",
        "method"
      ],
      "properties": {
        "provider": {
          "$ref": "#/$defs/name"
        },
        "runtime_id": {
          "$ref": "#/$defs/text"
        },
        "state": {
          "enum": [
            "deleted",
            "absent"
          ]
        },
        "observed_at": {
          "$ref": "#/$defs/timestamp"
        },
        "observer": {
          "$ref": "#/$defs/text"
        },
        "method": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "collectorArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "case_id",
        "sha256",
        "task_id",
        "output_hash",
        "file_hashes"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/text"
        },
        "case_id": {
          "$ref": "#/$defs/text"
        },
        "sha256": {
          "$ref": "#/$defs/digest"
        },
        "task_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 512,
              "pattern": "^[^\\u0000-\\u001f\\u007f]*\\S[^\\u0000-\\u001f\\u007f]*$"
            },
            {
              "type": "null"
            }
          ]
        },
        "output_hash": {
          "anyOf": [
            {
              "$ref": "#/$defs/digest"
            },
            {
              "type": "null"
            }
          ]
        },
        "file_hashes": {
          "anyOf": [
            {
              "type": "object",
              "minProperties": 1,
              "propertyNames": {
                "$ref": "#/$defs/relativePath"
              },
              "additionalProperties": {
                "$ref": "#/$defs/digest"
              }
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "collectorExport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "record",
        "collector",
        "assignment",
        "artifacts",
        "task",
        "vote",
        "invalidated"
      ],
      "properties": {
        "schema_version": {
          "const": "benchflow.assessment-collector-export.v1"
        },
        "record": {
          "enum": [
            "assignment",
            "vote"
          ]
        },
        "collector": {
          "$ref": "#/$defs/collectorPin"
        },
        "assignment": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "case_id",
            "phase",
            "reviewer",
            "left_id",
            "right_id",
            "left_hash",
            "right_hash",
            "task_id",
            "created"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/text"
            },
            "case_id": {
              "$ref": "#/$defs/text"
            },
            "phase": {
              "enum": [
                "distillation",
                "evaluation"
              ]
            },
            "reviewer": {
              "$ref": "#/$defs/reviewer"
            },
            "left_id": {
              "$ref": "#/$defs/text"
            },
            "right_id": {
              "$ref": "#/$defs/text"
            },
            "left_hash": {
              "$ref": "#/$defs/digest"
            },
            "right_hash": {
              "$ref": "#/$defs/digest"
            },
            "task_id": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512,
                  "pattern": "^[^\\u0000-\\u001f\\u007f]*\\S[^\\u0000-\\u001f\\u007f]*$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "created": {
              "type": "string",
              "minLength": 19,
              "maxLength": 40
            }
          }
        },
        "artifacts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "left",
            "right"
          ],
          "properties": {
            "left": {
              "$ref": "#/$defs/collectorArtifact"
            },
            "right": {
              "$ref": "#/$defs/collectorArtifact"
            }
          }
        },
        "task": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "version",
                "case_id",
                "rubric_id",
                "rubric_hash",
                "status"
              ],
              "properties": {
                "id": {
                  "$ref": "#/$defs/text"
                },
                "version": {
                  "$ref": "#/$defs/count"
                },
                "case_id": {
                  "$ref": "#/$defs/text"
                },
                "rubric_id": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 512,
                      "pattern": "^[^\\u0000-\\u001f\\u007f]*\\S[^\\u0000-\\u001f\\u007f]*$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "rubric_hash": {
                  "anyOf": [
                    {
                      "$ref": "#/$defs/digest"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "status": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64,
                  "pattern": "^[^\\u0000-\\u001f\\u007f]*\\S[^\\u0000-\\u001f\\u007f]*$"
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "vote": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "assignment_id",
                "reviewer",
                "choice",
                "reason",
                "tags",
                "created"
              ],
              "properties": {
                "id": {
                  "$ref": "#/$defs/text"
                },
                "assignment_id": {
                  "$ref": "#/$defs/text"
                },
                "reviewer": {
                  "$ref": "#/$defs/reviewer"
                },
                "choice": {
                  "enum": [
                    "left",
                    "right",
                    "tie",
                    "skip"
                  ]
                },
                "reason": {
                  "type": "string",
                  "minLength": 0,
                  "maxLength": 4000,
                  "pattern": "^[^\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f]*$"
                },
                "tags": {
                  "$ref": "#/$defs/tags"
                },
                "created": {
                  "type": "string",
                  "minLength": 19,
                  "maxLength": 40
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "invalidated": {
          "type": "boolean"
        }
      }
    },
    "createdPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attempts",
        "rubric",
        "judge_protocol"
      ],
      "properties": {
        "attempts": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/savedAttemptRef"
          }
        },
        "rubric": {
          "$ref": "#/$defs/frozenFile"
        },
        "judge_protocol": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "version",
            "sha256",
            "bytes",
            "locator",
            "collector"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[^\\u0000-\\u001f\\u007f]*\\S[^\\u0000-\\u001f\\u007f]*$"
            },
            "version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[^\\u0000-\\u001f\\u007f]*\\S[^\\u0000-\\u001f\\u007f]*$"
            },
            "sha256": {
              "$ref": "#/$defs/digest"
            },
            "bytes": {
              "type": "integer",
              "minimum": 1
            },
            "locator": {
              "$ref": "#/$defs/locator"
            },
            "collector": {
              "$ref": "#/$defs/collectorPin"
            }
          }
        }
      }
    },
    "releasedPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runtime_refs",
        "released_at",
        "release_proof"
      ],
      "properties": {
        "runtime_refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "attempt_id",
              "provider",
              "runtime_id",
              "role"
            ],
            "properties": {
              "attempt_id": {
                "$ref": "#/$defs/digest"
              },
              "provider": {
                "$ref": "#/$defs/name"
              },
              "runtime_id": {
                "$ref": "#/$defs/text"
              },
              "role": {
                "enum": [
                  "solver",
                  "verifier",
                  "shared"
                ]
              }
            }
          }
        },
        "released_at": {
          "$ref": "#/$defs/timestamp"
        },
        "release_proof": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sha256",
            "observations"
          ],
          "properties": {
            "sha256": {
              "$ref": "#/$defs/digest"
            },
            "observations": {
              "type": "array",
              "minItems": 1,
              "maxItems": 256,
              "items": {
                "$ref": "#/$defs/observation"
              }
            }
          }
        }
      }
    },
    "assignedPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "collector",
        "presentation",
        "reviewer_subject",
        "collector_export"
      ],
      "properties": {
        "collector": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "implementation",
            "commit",
            "assignment_id",
            "export_sha256"
          ],
          "properties": {
            "implementation": {
              "$ref": "#/$defs/name"
            },
            "commit": {
              "$ref": "#/$defs/commit"
            },
            "assignment_id": {
              "$ref": "#/$defs/text"
            },
            "export_sha256": {
              "$ref": "#/$defs/digest"
            }
          }
        },
        "presentation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "A",
            "B"
          ],
          "properties": {
            "A": {
              "$ref": "#/$defs/digest"
            },
            "B": {
              "$ref": "#/$defs/digest"
            }
          }
        },
        "reviewer_subject": {
          "$ref": "#/$defs/reviewer"
        },
        "collector_export": {
          "allOf": [
            {
              "$ref": "#/$defs/collectorExport"
            },
            {
              "properties": {
                "record": {
                  "const": "assignment"
                }
              }
            }
          ]
        }
      }
    },
    "submittedPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assignment_id",
        "reviewer_subject",
        "choice",
        "reason",
        "tags",
        "submitted_at",
        "imported_from",
        "collector_export"
      ],
      "properties": {
        "assignment_id": {
          "$ref": "#/$defs/text"
        },
        "reviewer_subject": {
          "$ref": "#/$defs/reviewer"
        },
        "choice": {
          "enum": [
            "left",
            "right",
            "tie",
            "abstain"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 0,
          "maxLength": 4000,
          "pattern": "^[^\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f]*$"
        },
        "tags": {
          "$ref": "#/$defs/tags"
        },
        "submitted_at": {
          "$ref": "#/$defs/timestamp"
        },
        "imported_from": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "collector",
            "record_id",
            "export_sha256"
          ],
          "properties": {
            "collector": {
              "$ref": "#/$defs/name"
            },
            "record_id": {
              "$ref": "#/$defs/text"
            },
            "export_sha256": {
              "$ref": "#/$defs/digest"
            }
          }
        },
        "collector_export": {
          "allOf": [
            {
              "$ref": "#/$defs/collectorExport"
            },
            {
              "properties": {
                "record": {
                  "const": "vote"
                }
              }
            }
          ]
        }
      }
    },
    "correctedPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "supersedes_event_id",
        "assignment_id",
        "reviewer_subject",
        "choice",
        "reason",
        "tags",
        "correction_reason",
        "corrected_at"
      ],
      "properties": {
        "supersedes_event_id": {
          "$ref": "#/$defs/uuid7"
        },
        "assignment_id": {
          "$ref": "#/$defs/text"
        },
