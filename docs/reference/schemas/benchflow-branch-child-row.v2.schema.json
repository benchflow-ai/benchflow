{
  "$defs": {
    "message": {
      "properties": {
        "content": {
          "type": "string"
        },
        "reasoning_content": {
          "description": "The agent's visible thinking for this turn.",
          "type": "string"
        },
        "role": {
          "enum": [
            "system",
            "user",
            "assistant",
            "tool"
          ]
        },
        "tool_call_id": {
          "description": "On role tool: the id of the call it answers.",
          "type": "string"
        },
        "tool_calls": {
          "items": {
            "$ref": "#/$defs/tool_call"
          },
          "type": "array"
        }
      },
      "required": [
        "role"
      ],
      "type": "object"
    },
    "messages": {
      "items": {
        "$ref": "#/$defs/message"
      },
      "type": "array"
    },
    "session": {
      "description": "fork snapshot agent_session: fresh, resumed, \u2026",
      "type": "string"
    },
    "tool": {
      "description": "Inferred from the recorded calls (argument names only); the agent's own tool definitions are not recorded.",
      "properties": {
        "function": {
          "properties": {
            "description": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "parameters": {
              "type": "object"
            }
          },
          "required": [
            "name",
            "parameters"
          ],
          "type": "object"
        },
        "type": {
          "const": "function"
        }
      },
      "required": [
        "type",
        "function"
      ],
      "type": "object"
    },
    "tool_call": {
      "properties": {
        "function": {
          "properties": {
            "arguments": {
              "description": "The call's input as a JSON string.",
              "type": "string"
            },
            "name": {
              "description": "The agent's tool name (Write, Bash, \u2026); inferred from the call when the agent did not send one (see tool_names).",
              "type": "string"
            }
          },
          "required": [
            "name",
            "arguments"
          ],
          "type": "object"
        },
        "id": {
          "type": "string"
        },
        "type": {
          "const": "function"
        }
      },
      "required": [
        "id",
        "type",
        "function"
      ],
      "type": "object"
    },
    "tools": {
      "items": {
        "$ref": "#/$defs/tool"
      },
      "type": "array"
    }
  },
  "$id": "https://benchflow.ai/schemas/benchflow-branch-child-row.v2.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "One child of one fork: the shared prefix, this child's continuation and its reward, value and advantage.",
  "properties": {
    "advantage": {
      "description": "reward - value.",
      "type": [
        "number",
        "null"
      ]
    },
    "agent": {
      "type": [
        "string",
        "null"
      ]
    },
    "child": {
      "properties": {
        "index": {
          "type": [
            "integer",
            "null"
          ]
        },
        "label": {
          "type": [
            "string",
            "null"
          ]
        },
        "node_id": {
          "type": "string"
        },
        "path": {
          "type": [
            "string",
            "null"
          ]
        },
        "requested": {
          "type": [
            "string",
            "null"
          ]
        },
        "reward": {
          "description": "null when unscored.",
          "type": [
            "number",
            "null"
          ]
        },
        "reward_source": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "node_id",
        "reward"
      ],
      "type": "object"
    },
    "continuation": {
      "$ref": "#/$defs/messages"
    },
    "depth": {
      "description": "1 for a fork of the trial, 2 for a fork inside a child\u2026",
      "minimum": 1,
      "type": "integer"
    },
    "fork_id": {
      "type": "string"
    },
    "fork_kind": {
      "enum": [
        "fork",
        "retry"
      ]
    },
    "fork_status": {
      "type": [
        "string",
        "null"
      ]
    },
    "kind": {
      "const": "branch_child"
    },
    "messages": {
      "$ref": "#/$defs/messages",
      "description": "prefix + continuation, ready for apply_chat_template."
    },
    "model": {
      "type": [
        "string",
        "null"
      ]
    },
    "parent_child": {
      "description": "Node id of the child whose fork this is (nested), else null.",
      "type": [
        "string",
        "null"
      ]
    },
    "parent_node": {
      "type": [
        "string",
        "null"
      ]
    },
    "prefix": {
      "$ref": "#/$defs/messages"
    },
    "prefix_complete": {
      "description": "False when the trial started from a kept checkpoint whose source conversation could not be found, so the prefix lacks it.",
      "type": "boolean"
    },
    "prefix_source": {
      "description": "For a trial started from a kept checkpoint: the source trial, checkpoint and number of events prepended.",
      "properties": {
        "checkpoint": {
          "type": [
            "string",
            "null"
          ]
        },
        "events": {
          "type": [
            "integer",
            "null"
          ]
        },
        "trial": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": [
        "object",
        "null"
      ]
    },
    "schema_version": {
      "const": 2
    },
    "session": {
      "$ref": "#/$defs/session"
    },
    "siblings": {
      "minimum": 1,
      "type": "integer"
    },
    "task": {
      "type": [
        "string",
        "null"
      ]
    },
    "tool_names": {
      "description": "Whether tool names came from the agent or were inferred from the calls.",
      "enum": [
        "agent",
        "inferred",
        "mixed",
        null
      ]
    },
    "tools": {
      "$ref": "#/$defs/tools"
    },
    "trial": {
      "description": "Trial folder name.",
      "type": "string"
    },
    "value": {
      "description": "Mean reward of the fork's children.",
      "type": [
        "number",
        "null"
      ]
    },
    "value_stderr": {
      "type": [
        "number",
        "null"
      ]
    }
  },
  "required": [
    "kind",
    "schema_version",
    "trial",
    "fork_id",
    "depth",
    "value",
    "child",
    "advantage",
    "session",
    "prefix_complete",
    "prefix",
    "continuation",
    "messages",
    "tools"
  ],
  "title": "BenchFlow branch-tree child row (children.jsonl)",
  "type": "object"
}
