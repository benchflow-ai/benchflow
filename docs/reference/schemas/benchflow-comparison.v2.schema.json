{
  "$defs": {
    "ComparisonRowExport": {
      "properties": {
        "checks": {
          "items": {
            "$ref": "#/$defs/SettingCheckExport"
          },
          "title": "Checks",
          "type": "array"
        },
        "delta": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "reward_b - reward_a",
          "title": "Delta"
        },
        "group": {
          "additionalProperties": true,
          "description": "the row's values of the by keys (1.1)",
          "title": "Group",
          "type": "object"
        },
        "n_a": {
          "title": "N A",
          "type": "integer"
        },
        "n_b": {
          "title": "N B",
          "type": "integer"
        },
        "reward_a": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reward A"
        },
        "reward_b": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reward B"
        },
        "scored_a": {
          "title": "Scored A",
          "type": "integer"
        },
        "scored_b": {
          "title": "Scored B",
          "type": "integer"
        },
        "status": {
          "enum": [
            "paired",
            "only_a",
            "only_b"
          ],
          "title": "Status",
          "type": "string"
        },
        "task": {
          "title": "Task",
          "type": "string"
        }
      },
      "required": [
        "task",
        "status",
        "n_a",
        "n_b",
        "scored_a",
        "scored_b",
        "reward_a",
        "reward_b",
        "delta",
        "checks"
      ],
      "title": "ComparisonRowExport",
      "type": "object"
    },
    "ComparisonSideExport": {
      "properties": {
        "denominators": {
          "$ref": "#/$defs/DenominatorsExport"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "solve_rates": {
          "anyOf": [
            {
              "$ref": "#/$defs/SolveRatesExport"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "label",
        "path",
        "denominators"
      ],
      "title": "ComparisonSideExport",
      "type": "object"
    },
    "ComparisonSummaryExport": {
      "properties": {
        "b_higher": {
          "title": "B Higher",
          "type": "integer"
        },
        "b_lower": {
          "title": "B Lower",
          "type": "integer"
        },
        "both_scored": {
          "title": "Both Scored",
          "type": "integer"
        },
        "mean_delta": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Mean Delta"
        },
        "one_run_per_side": {
          "title": "One Run Per Side",
          "type": "boolean"
        },
        "only_a": {
          "title": "Only A",
          "type": "integer"
        },
        "only_b": {
          "title": "Only B",
          "type": "integer"
        },
        "paired": {
          "title": "Paired",
          "type": "integer"
        },
        "same_reward": {
          "title": "Same Reward",
          "type": "integer"
        },
        "setting_mismatches": {
          "title": "Setting Mismatches",
          "type": "integer"
        },
        "tasks": {
          "title": "Tasks",
          "type": "integer"
        }
      },
      "required": [
        "tasks",
        "paired",
        "only_a",
        "only_b",
        "both_scored",
        "same_reward",
        "b_higher",
        "b_lower",
        "mean_delta",
        "one_run_per_side",
        "setting_mismatches"
      ],
      "title": "ComparisonSummaryExport",
      "type": "object"
    },
    "DenominatorsExport": {
      "properties": {
        "assessment_errors": {
          "title": "Assessment Errors",
          "type": "integer"
        },
        "attempted": {
          "title": "Attempted",
          "type": "integer"
        },
        "clean_passed": {
          "title": "Clean Passed",
          "type": "integer"
        },
        "clean_scored": {
          "title": "Clean Scored",
          "type": "integer"
        },
        "controls_excluded": {
          "title": "Controls Excluded",
          "type": "integer"
        },
        "execution_errors": {
          "title": "Execution Errors",
          "type": "integer"
        },
        "integration_failures": {
          "default": 0,
          "description": "attempted runs whose agent integration broke; also counted in unscored and execution_errors (1.2)",
          "title": "Integration Failures",
          "type": "integer"
        },
        "mean_reward": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "over attempted runs, an unscored run counting 0 (2.0)",
          "title": "Mean Reward"
        },
        "mean_reward_scored_only": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "over scored runs only, as mean_reward was in 1.x (2.0)",
          "title": "Mean Reward Scored Only"
        },
        "pass_rate_attempted": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Pass Rate Attempted"
        },
        "pass_rate_clean": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Pass Rate Clean"
        },
        "pass_rate_scored": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Pass Rate Scored"
        },
        "passed": {
          "title": "Passed",
          "type": "integer"
        },
        "scored": {
          "title": "Scored",
          "type": "integer"
        },
        "unscored": {
          "title": "Unscored",
          "type": "integer"
        }
      },
      "required": [
        "attempted",
        "scored",
        "assessment_errors",
        "unscored",
        "execution_errors",
        "passed",
        "mean_reward",
        "pass_rate_scored",
        "pass_rate_attempted",
        "clean_scored",
        "clean_passed",
        "pass_rate_clean",
        "controls_excluded"
      ],
      "title": "DenominatorsExport",
      "type": "object"
    },
    "SettingCheckExport": {
      "properties": {
        "a": {
          "anyOf": [
            {
              "items": {},
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "A"
        },
        "b": {
          "anyOf": [
            {
              "items": {},
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "B"
        },
        "match": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "description": "null when neither side recorded it",
          "title": "Match"
        },
        "setting": {
          "title": "Setting",
          "type": "string"
        }
      },
      "required": [
        "setting",
        "match"
      ],
      "title": "SettingCheckExport",
      "type": "object"
    },
    "SettingMismatchExport": {
      "properties": {
        "a": {
          "items": {},
          "title": "A",
          "type": "array"
        },
        "b": {
          "items": {},
          "title": "B",
          "type": "array"
        },
        "setting": {
          "title": "Setting",
          "type": "string"
        },
        "task": {
          "title": "Task",
          "type": "string"
        }
      },
      "required": [
        "task",
        "setting",
        "a",
        "b"
      ],
      "title": "SettingMismatchExport",
      "type": "object"
    },
    "SolveRatesExport": {
      "description": "pass@k, pass^k and the solve rate (``benchflow.pass_at_k``).\n\nSince 2.0 every trial is a sample (an unscored one counts as not solved);\nthe ``*_scored_only`` fields are the 1.x figures over scored trials only.",
      "properties": {
        "caveats": {
          "items": {
            "type": "string"
          },
          "title": "Caveats",
          "type": "array"
        },
        "controls_excluded": {
          "title": "Controls Excluded",
          "type": "integer"
        },
        "ks": {
          "items": {
            "type": "integer"
          },
          "title": "Ks",
          "type": "array"
        },
        "max_trials_per_task": {
          "title": "Max Trials Per Task",
          "type": "integer"
        },
        "min_trials_per_task": {
          "title": "Min Trials Per Task",
          "type": "integer"
        },
        "nonbinary_rewards": {
          "title": "Nonbinary Rewards",
          "type": "integer"
        },
        "pass_at_k": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Pass At K",
          "type": "object"
        },
        "pass_at_k_scored_only": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "description": "pass@k over scored trials only, as pass_at_k was in 1.x (2.0)",
          "title": "Pass At K Scored Only",
          "type": "object"
        },
        "pass_hat_k": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Pass Hat K",
          "type": "object"
        },
        "pass_hat_k_scored_only": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "description": "pass^k over scored trials only (2.0)",
          "title": "Pass Hat K Scored Only",
          "type": "object"
        },
        "scored": {
          "description": "scored trials: the n of the *_scored_only figures (2.0)",
          "title": "Scored",
          "type": "integer"
        },
        "solve_rate": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Solve Rate"
        },
        "solve_rate_interval": {
          "anyOf": [
            {
              "items": {
                "type": "number"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "95% interval of solve_rate, [low, high] (1.3); see solve_rate_interval_method",
          "title": "Solve Rate Interval"
        },
        "solve_rate_interval_method": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "wilson (one trial per task) or wilson-clustered (Wilson on the design-effect sample size, for repeated trials) (1.3)",
          "title": "Solve Rate Interval Method"
        },
        "solve_rate_scored_only": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "solved over scored trials, as solve_rate was in 1.x (2.0)",
          "title": "Solve Rate Scored Only"
        },
        "solve_rate_scored_only_interval": {
          "anyOf": [
            {
              "items": {
                "type": "number"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "description": "95% interval of solve_rate_scored_only (2.0)",
          "title": "Solve Rate Scored Only Interval"
        },
        "solve_rate_scored_only_interval_method": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "as solve_rate_interval_method, over scored trials (2.0)",
          "title": "Solve Rate Scored Only Interval Method"
        },
        "solve_threshold": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "null: a trial succeeds when it passed; else reward >= threshold",
          "title": "Solve Threshold"
        },
        "success_rule": {
          "title": "Success Rule",
          "type": "string"
        },
        "tasks": {
          "description": "tasks with at least one trial",
          "title": "Tasks",
          "type": "integer"
        },
        "tasks_at_k": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Tasks At K",
          "type": "object"
        },
        "tasks_at_k_scored_only": {
          "additionalProperties": {
            "type": "integer"
          },
          "description": "tasks with at least k scored trials (2.0)",
          "title": "Tasks At K Scored Only",
          "type": "object"
        },
        "tasks_scored_only": {
          "description": "tasks with at least one scored trial (2.0)",
          "title": "Tasks Scored Only",
          "type": "integer"
        },
        "tasks_short_at_k": {
          "additionalProperties": {
            "type": "integer"
          },
          "description": "tasks with fewer than k trials, left out of that k",
          "title": "Tasks Short At K",
          "type": "object"
        },
        "tasks_short_at_k_scored_only": {
          "additionalProperties": {
            "type": "integer"
          },
          "description": "tasks with a scored trial but fewer than k (2.0)",
          "title": "Tasks Short At K Scored Only",
          "type": "object"
        },
        "trials": {
          "description": "every trial: the n of solve_rate, pass_at_k and pass_hat_k (scored trials only in 1.x) (2.0)",
          "title": "Trials",
          "type": "integer"
        },
        "unscored": {
          "description": "trials without a score: in trials (as fails), not in scored",
          "title": "Unscored",
          "type": "integer"
        }
      },
      "required": [
        "success_rule",
        "solve_threshold",
        "tasks",
        "trials",
        "scored",
        "unscored",
        "controls_excluded",
        "min_trials_per_task",
        "max_trials_per_task",
        "solve_rate",
        "tasks_scored_only",
        "solve_rate_scored_only",
        "solve_rate_scored_only_interval",
        "solve_rate_scored_only_interval_method",
        "nonbinary_rewards",
        "ks",
        "pass_at_k",
        "pass_hat_k",
        "tasks_at_k",
        "tasks_short_at_k",
        "pass_at_k_scored_only",
        "pass_hat_k_scored_only",
        "tasks_at_k_scored_only",
        "tasks_short_at_k_scored_only",
        "caveats"
      ],
      "title": "SolveRatesExport",
      "type": "object"
    }
  },
  "$id": "https://benchflow.ai/schemas/benchflow-comparison.v2.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "a": {
      "$ref": "#/$defs/ComparisonSideExport"
    },
    "a_paired": {
      "anyOf": [
        {
          "$ref": "#/$defs/DenominatorsExport"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "side A over the tasks both sides ran (1.1)"
    },
    "b": {
      "$ref": "#/$defs/ComparisonSideExport"
    },
    "b_paired": {
      "anyOf": [
        {
          "$ref": "#/$defs/DenominatorsExport"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "by": {
      "description": "extra pairing keys besides task (1.1)",
      "items": {
        "type": "string"
      },
      "title": "By",
      "type": "array"
    },
    "caveats": {
      "items": {
        "type": "string"
      },
      "title": "Caveats",
      "type": "array"
    },
    "include_controls": {
      "title": "Include Controls",
      "type": "boolean"
    },
    "kind": {
      "const": "benchflow.comparison",
      "default": "benchflow.comparison",
      "title": "Kind",
      "type": "string"
    },
    "mismatches": {
      "items": {
        "$ref": "#/$defs/SettingMismatchExport"
      },
      "title": "Mismatches",
      "type": "array"
    },
    "rows": {
      "items": {
        "$ref": "#/$defs/ComparisonRowExport"
      },
      "title": "Rows",
      "type": "array"
    },
    "schema_minor": {
      "default": 1,
      "description": "optional fields added within schema_version; see the changelog",
      "title": "Schema Minor",
      "type": "integer"
    },
    "schema_version": {
      "const": 2,
      "default": 2,
      "title": "Schema Version",
      "type": "integer"
    },
    "scoring": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "the scoring rule's figures for each side on the tasks both ran, the gap b - a with its 95% interval paired by task, its warnings, and each side's mixed settings (2.1)",
      "title": "Scoring"
    },
    "summary": {
      "$ref": "#/$defs/ComparisonSummaryExport"
    },
    "vary": {
      "items": {
        "type": "string"
      },
      "title": "Vary",
      "type": "array"
    }
  },
  "required": [
    "a",
    "b",
    "include_controls",
    "vary",
    "summary",
    "rows",
    "mismatches",
    "caveats"
  ],
  "title": "ComparisonExport",
  "type": "object"
}
