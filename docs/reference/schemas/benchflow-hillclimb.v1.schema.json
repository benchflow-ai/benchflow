      "type": "string"
    },
    "best": {
      "anyOf": [
        {
          "$ref": "#/$defs/BestDoc"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "config": {
      "$ref": "#/$defs/ConfigDoc"
    },
    "controls": {
      "anyOf": [
        {
          "$ref": "#/$defs/ControlsDoc"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "cost": {
      "$ref": "#/$defs/CostDoc"
    },
    "created_at": {
      "title": "Created At",
      "type": "string"
    },
    "kind": {
      "const": "benchflow.hillclimb",
      "default": "benchflow.hillclimb",
      "title": "Kind",
      "type": "string"
    },
    "noise_gate": {
      "anyOf": [
        {
          "$ref": "#/$defs/NoiseGateDoc"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "paths": {
      "$ref": "#/$defs/PathsDoc"
    },
    "rounds": {
      "items": {
        "$ref": "#/$defs/RoundDoc"
      },
      "title": "Rounds",
      "type": "array"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "split": {
      "$ref": "#/$defs/SplitDoc"
    },
    "status": {
      "enum": [
        "running",
        "finished",
        "refused",
        "stopped",
        "failed"
      ],
      "title": "Status",
      "type": "string"
