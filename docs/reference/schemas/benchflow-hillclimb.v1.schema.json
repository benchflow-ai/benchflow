{
  "$defs": {
    "AnalysisDoc": {
      "properties": {
        "cost_usd": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cost Usd"
        },
        "counts": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Counts",
          "type": "object"
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error"
        },
        "failures": {
          "items": {
            "$ref": "#/$defs/AnalysisFailureDoc"
          },
          "title": "Failures",
          "type": "array"
        },
        "recommendations": {
          "items": {
            "type": "string"
          },
          "title": "Recommendations",
          "type": "array"
        },
        "rollout_dir": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rollout Dir"
        },
        "status": {
          "enum": [
            "ok",
            "failed"
          ],
          "title": "Status",
          "type": "string"
        },
        "summary": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Summary"
        },
        "trigger": {
          "enum": [
            "stall",
            "end"
          ],
          "title": "Trigger",
          "type": "string"
        },
        "workspace_dir": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Workspace Dir"
        }
      },
      "required": [
        "trigger",
        "status"
      ],
      "title": "AnalysisDoc",
      "type": "object"
    },
    "AnalysisFailureDoc": {
      "properties": {
        "category": {
          "enum": [
            "ambiguous_task",
            "grader_bug",
            "infrastructure",
            "capability_gap"
          ],
          "title": "Category",
          "type": "string"
        },
        "explanation": {
          "title": "Explanation",
          "type": "string"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "task": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Task"
        }
      },
      "required": [
        "id",
        "category",
        "explanation"
      ],
      "title": "AnalysisFailureDoc",
      "type": "object"
    },
    "BestDoc": {
      "properties": {
        "candidate": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Candidate"
        },
        "cost_change_vs_baseline": {
          "anyOf": [
            {
              "$ref": "#/$defs/CostChangeDoc"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "git_commit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Git Commit"
        },
        "round": {
          "description": "0 for the baseline",
          "title": "Round",
          "type": "integer"
        },
        "surface_dir": {
          "title": "Surface Dir",
          "type": "string"
        },
        "test": {
          "$ref": "#/$defs/EstimateDoc"
        },
        "test_delta_vs_baseline": {
          "anyOf": [
            {
              "$ref": "#/$defs/DeltaDoc"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "train": {
          "$ref": "#/$defs/EstimateDoc"
        },
        "train_delta_vs_baseline": {
          "anyOf": [
            {
              "$ref": "#/$defs/DeltaDoc"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "verdict": {
          "$ref": "#/$defs/VerdictDoc"
        },
        "version": {
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "version",
        "round",
        "surface_dir",
        "train",
        "test",
        "verdict"
      ],
      "title": "BestDoc",
      "type": "object"
    },
    "CandidateDoc": {
      "properties": {
        "base_version": {
          "title": "Base Version",
          "type": "string"
        },
        "change": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Change"
        },
        "cost_change": {
          "anyOf": [
            {
              "$ref": "#/$defs/CostChangeDoc"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "decision": {
          "enum": [
            "keep",
            "revert",
            "invalid"
          ],
          "title": "Decision",
          "type": "string"
        },
        "diff": {
          "default": "",
          "title": "Diff",
          "type": "string"
        },
        "diff_stats": {
          "anyOf": [
            {
              "$ref": "#/$defs/DiffStatsDoc"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "diff_truncated": {
          "default": false,
          "title": "Diff Truncated",
          "type": "boolean"
        },
        "evaluation": {
          "anyOf": [
            {
              "$ref": "#/$defs/EvaluationDoc"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "evidence": {
          "items": {
            "type": "string"
          },
          "title": "Evidence",
          "type": "array"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "leak_check": {
          "anyOf": [
            {
              "$ref": "#/$defs/LeakCheckDoc"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "proposer": {
          "$ref": "#/$defs/ProposerDoc"
        },
        "rationale": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rationale"
        },
        "reasons": {
          "items": {
            "type": "string"
          },
          "title": "Reasons",
          "type": "array"
        },
        "root_cause": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Root Cause"
        },
        "round": {
          "title": "Round",
          "type": "integer"
        },
        "test_delta": {
          "anyOf": [
            {
              "$ref": "#/$defs/DeltaDoc"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "train_delta": {
          "anyOf": [
            {
              "$ref": "#/$defs/DeltaDoc"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Version"
        }
      },
      "required": [
        "id",
        "round",
        "base_version",
        "version",
        "proposer",
        "decision"
      ],
      "title": "CandidateDoc",
      "type": "object"
    },
    "ConfigDoc": {
      "properties": {
        "agent": {
          "title": "Agent",
          "type": "string"
        },
        "agent_env_keys": {
          "items": {
            "type": "string"
          },
          "title": "Agent Env Keys",
          "type": "array"
        },
        "bootstrap_samples": {
          "title": "Bootstrap Samples",
          "type": "integer"
        },
        "candidates": {
          "title": "Candidates",
          "type": "integer"
        },
        "concurrency": {
          "title": "Concurrency",
          "type": "integer"
        },
        "config_override": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Config Override"
        },
        "environment": {
          "title": "Environment",
          "type": "string"
        },
        "force": {
          "title": "Force",
          "type": "boolean"
        },
        "leak_check": {
          "enum": [
            "reject",
            "warn",
            "off"
          ],
          "title": "Leak Check",
          "type": "string"
        },
        "max_cost_usd": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Max Cost Usd"
        },
        "max_infra_error_rate": {
          "title": "Max Infra Error Rate",
          "type": "number"
        },
        "min_gain": {
          "title": "Min Gain",
          "type": "number"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Model"
        },
        "objective": {
          "enum": [
            "score",
            "cost"
          ],
          "title": "Objective",
          "type": "string"
        },
        "proposer": {
          "$ref": "#/$defs/ProposerConfigDoc"
        },
        "reasoning_effort": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reasoning Effort"
        },
        "rounds": {
          "title": "Rounds",
          "type": "integer"
        },
        "seed": {
          "title": "Seed",
          "type": "integer"
        },
        "stall_rounds": {
          "title": "Stall Rounds",
          "type": "integer"
        },
        "surfaces": {
          "items": {
            "$ref": "#/$defs/SurfaceDoc"
          },
          "title": "Surfaces",
          "type": "array"
        },
        "tasks": {
          "description": "the task folders (absolute)",
          "items": {
            "type": "string"
          },
          "title": "Tasks",
          "type": "array"
        },
        "trials": {
          "title": "Trials",
          "type": "integer"
        }
      },
      "required": [
        "tasks",
        "surfaces",
        "agent",
        "model",
        "reasoning_effort",
        "environment",
        "concurrency",
        "objective",
        "rounds",
        "trials",
        "min_gain",
        "max_cost_usd",
        "stall_rounds",
        "candidates",
        "max_infra_error_rate",
        "leak_check",
        "bootstrap_samples",
        "seed",
        "force",
        "proposer"
      ],
      "title": "ConfigDoc",
      "type": "object"
    },
    "ControlTaskDoc": {
      "properties": {
        "flags": {
          "description": "oracle_fails, nop_passes, oracle_unscored, nop_unscored, no_oracle",
          "items": {
            "type": "string"
          },
          "title": "Flags",
          "type": "array"
        },
        "nop_error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Nop Error"
        },
        "nop_reward": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Nop Reward"
        },
        "oracle_error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Oracle Error"
        },
        "oracle_ran": {
          "default": false,
          "title": "Oracle Ran",
          "type": "boolean"
        },
        "oracle_reward": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Oracle Reward"
        },
        "split": {
          "enum": [
            "train",
            "test"
          ],
          "title": "Split",
          "type": "string"
        },
        "task": {
          "title": "Task",
          "type": "string"
        }
      },
      "required": [
        "task",
        "split"
      ],
      "title": "ControlTaskDoc",
      "type": "object"
    },
    "ControlsDoc": {
      "properties": {
        "excluded": {
          "description": "tasks dropped by --exclude-broken-tasks",
          "items": {
            "type": "string"
          },
          "title": "Excluded",
          "type": "array"
        },
        "grader_bugs": {
          "description": "tasks whose oracle does not pass or where doing nothing passes",
          "items": {
            "type": "string"
          },
          "title": "Grader Bugs",
          "type": "array"
        },
        "judge_consistency": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "what was done to check LLM-judged tasks' graders",
          "title": "Judge Consistency"
        },
        "nop_job_dir": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Nop Job Dir"
        },
        "oracle_job_dir": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Oracle Job Dir"
        },
        "ran": {
          "title": "Ran",
          "type": "boolean"
        },
        "skipped_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Skipped Reason"
        },
        "tasks": {
          "items": {
            "$ref": "#/$defs/ControlTaskDoc"
          },
          "title": "Tasks",
          "type": "array"
        }
      },
      "required": [
        "ran"
      ],
      "title": "ControlsDoc",
      "type": "object"
    },
    "CostChangeDoc": {
      "properties": {
        "test": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Test"
        },
        "train": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "relative change in USD per trial on train (negative = cheaper)",
          "title": "Train"
        }
      },
      "required": [
        "train",
        "test"
      ],
      "title": "CostChangeDoc",
      "type": "object"
    },
    "CostDoc": {
      "properties": {
        "agent_usd": {
          "title": "Agent Usd",
          "type": "number"
        },
        "budget_stopped": {
          "default": false,
          "title": "Budget Stopped",
          "type": "boolean"
        },
        "max_cost_usd": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Max Cost Usd"
        },
        "proposer_usd": {
          "title": "Proposer Usd",
          "type": "number"
        },
        "total_usd": {
          "description": "USD over every rollout with a known cost",
          "title": "Total Usd",
          "type": "number"
        },
        "usd_unknown_rollouts": {
          "description": "rollouts that reported no USD (a subscription login, or unpriced)",
          "title": "Usd Unknown Rollouts",
          "type": "integer"
        }
      },
      "required": [
        "total_usd",
        "agent_usd",
        "proposer_usd",
        "usd_unknown_rollouts",
        "max_cost_usd"
      ],
      "title": "CostDoc",
      "type": "object"
    },
    "DeltaDoc": {
      "properties": {
        "ci": {
          "anyOf": [
            {
              "$ref": "#/$defs/IntervalDoc"
            },
            {
              "type": "null"
            }
          ]
        },
        "method": {
          "default": "paired two-stage bootstrap over tasks and trials",
          "title": "Method",
          "type": "string"
        },
        "paired_tasks": {
          "title": "Paired Tasks",
          "type": "integer"
        },
        "samples": {
          "description": "bootstrap replicates",
          "title": "Samples",
          "type": "integer"
        },
        "se": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Se"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "B minus A over the paired tasks",
          "title": "Value"
        }
      },
      "required": [
        "value",
        "se",
        "ci",
        "paired_tasks",
        "samples"
      ],
      "title": "DeltaDoc",
      "type": "object"
    },
    "DiffStatsDoc": {
      "properties": {
        "added": {
          "title": "Added",
          "type": "integer"
        },
        "files_changed": {
          "title": "Files Changed",
          "type": "integer"
        },
        "removed": {
          "title": "Removed",
          "type": "integer"
        }
      },
      "required": [
        "files_changed",
        "added",
        "removed"
      ],
      "title": "DiffStatsDoc",
      "type": "object"
    },
    "EstimateDoc": {
      "properties": {
        "ci": {
          "anyOf": [
            {
              "$ref": "#/$defs/IntervalDoc"
            },
            {
              "type": "null"
            }
          ],
          "description": "95% percentile bootstrap interval"
        },
        "se": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "standard error, two-stage bootstrap over tasks and trials",
          "title": "Se"
        },
        "tasks": {
          "description": "tasks with at least one scored trial",
          "title": "Tasks",
          "type": "integer"
        },
        "trials": {
          "description": "scored trials",
          "title": "Trials",
          "type": "integer"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "the task-averaged mean",
          "title": "Value"
        }
      },
      "required": [
        "value",
        "se",
        "ci",
        "tasks",
        "trials"
      ],
      "title": "EstimateDoc",
      "type": "object"
    },
    "EvaluationDoc": {
      "properties": {
        "id": {
          "description": "baseline, or the candidate id (r01-c1)",
          "title": "Id",
          "type": "string"
        },
        "test": {
          "$ref": "#/$defs/SplitResultDoc"
        },
        "train": {
          "$ref": "#/$defs/SplitResultDoc"
        },
        "version": {
          "description": "the surface version it ran (v000, ...)",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "id",
        "version",
        "train",
        "test"
      ],
      "title": "EvaluationDoc",
      "type": "object"
    },
    "GateSplitDoc": {
      "properties": {
        "min_trials": {
          "title": "Min Trials",
          "type": "integer"
        },
        "noise_95": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "1.96 x noise_se",
          "title": "Noise 95"
        },
        "noise_se": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "SE of a rerun's score difference, two-stage bootstrap",
          "title": "Noise Se"
        },
        "ok": {
          "title": "Ok",
          "type": "boolean"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "se": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Se"
        },
        "split": {
          "enum": [
            "train",
            "test"
          ],
          "title": "Split",
          "type": "string"
        },
        "tasks": {
          "title": "Tasks",
          "type": "integer"
        },
        "threshold": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "noise_95 in the objective's unit (a fraction of cost for cost)",
          "title": "Threshold"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "split",
        "value",
        "se",
        "noise_se",
        "noise_95",
        "threshold",
        "tasks",
        "min_trials",
        "ok"
      ],
      "title": "GateSplitDoc",
      "type": "object"
    },
    "IntervalDoc": {
      "properties": {
        "high": {
          "title": "High",
          "type": "number"
        },
        "low": {
          "title": "Low",
          "type": "number"
        }
      },
      "required": [
        "low",
        "high"
      ],
      "title": "IntervalDoc",
      "type": "object"
    },
    "LeakCheckDoc": {
      "properties": {
        "matches": {
          "description": "runs of words the patch copies from train instructions or verifier output",
          "items": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object"
          },
          "title": "Matches",
          "type": "array"
        },
        "mode": {
          "enum": [
            "reject",
            "warn",
            "off"
          ],
          "title": "Mode",
          "type": "string"
        },
        "status": {
          "enum": [
            "clean",
            "flagged",
            "skipped"
          ],
