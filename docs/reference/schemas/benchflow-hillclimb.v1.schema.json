    "updated_at": {
      "title": "Updated At",
      "type": "string"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "status",
    "benchflow_version",
    "created_at",
    "updated_at",
    "config",
    "split",
    "cost",
    "paths"
  ],
  "title": "HillclimbDoc",
  "type": "object"
}
