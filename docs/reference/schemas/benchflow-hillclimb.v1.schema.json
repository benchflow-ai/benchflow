  "$id": "https://benchflow.ai/schemas/benchflow-hillclimb.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "The record of one ``bench hillclimb`` run.",
  "properties": {
    "analysis": {
      "anyOf": [
        {
          "$ref": "#/$defs/AnalysisDoc"
        },
        {
          "type": "null"
        }
      ],
