  "$id": "https://benchflow.ai/schemas/benchflow-job.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "cost_usd": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "title": "Cost Usd"
    },
    "denominators": {
      "$ref": "#/$defs/DenominatorsExport",
      "description": "agent runs; controls left out"
    },
    "denominators_with_controls": {
      "$ref": "#/$defs/DenominatorsExport"
    },
    "error_categories": {
      "additionalProperties": {
        "type": "integer"
      },
      "description": "agent runs that errored, by error_category (1.1)",
      "title": "Error Categories",
      "type": "object"
    },
    "groups": {
      "description": "agent-run denominators per agent and model (1.1)",
      "items": {
        "$ref": "#/$defs/GroupExport"
      },
      "title": "Groups",
      "type": "array"
    },
    "interrupted": {
      "description": "attempt folders that never wrote result.json (1.1)",
      "items": {
        "$ref": "#/$defs/InterruptedExport"
      },
      "title": "Interrupted",
      "type": "array"
    },
    "job_kind": {
      "enum": [
        "evaluation",
        "branch",
        "directory"
      ],
      "title": "Job Kind",
      "type": "string"
    },
    "kind": {
      "const": "benchflow.job",
      "default": "benchflow.job",
      "title": "Kind",
      "type": "string"
    },
    "path": {
      "title": "Path",
      "type": "string"
    },
    "schema_minor": {
      "default": 1,
      "description": "optional fields added within schema_version; see the changelog",
      "title": "Schema Minor",
      "type": "integer"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "solve_rates": {
      "anyOf": [
        {
          "$ref": "#/$defs/SolveRatesExport"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "agent runs; default ks and success rule"
    },
    "summary": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "the job's summary.json",
      "title": "Summary"
    },
    "timing_totals": {
      "additionalProperties": {
        "type": "number"
      },
      "description": "seconds per timing phase, summed over agent runs (1.1)",
      "title": "Timing Totals",
      "type": "object"
    },
    "trials": {
      "items": {
        "$ref": "#/$defs/TrialExport"
      },
      "title": "Trials",
      "type": "array"
    }
  },
  "required": [
    "path",
    "job_kind",
    "denominators",
    "denominators_with_controls",
    "cost_usd",
    "trials"
  ],
  "title": "JobExport",
  "type": "object"
}
