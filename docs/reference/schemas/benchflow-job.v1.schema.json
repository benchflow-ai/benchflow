{
  "$defs": {
    "BranchChildExport": {
      "additionalProperties": false,
      "properties": {
        "advantage": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "reward minus the value of the child's fork",
          "title": "Advantage"
        },
        "cost": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "the child's cost record",
          "title": "Cost"
        },
        "fork_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Fork Id"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "parent_label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "the child a nested fork was made from; null at the top",
          "title": "Parent Label"
        },
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "relative to the trial folder",
          "title": "Path"
        },
        "reward": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reward"
        },
        "reward_source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "verifier or runner_return",
          "title": "Reward Source"
        },
        "status": {
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "label",
        "status",
        "reward",
        "fork_id"
      ],
      "title": "BranchChildExport",
      "type": "object"
    },
    "DenominatorsExport": {
      "additionalProperties": false,
      "properties": {
        "assessment_errors": {
          "title": "Assessment Errors",
          "type": "integer"
        },
        "attempted": {
          "title": "Attempted",
          "type": "integer"
        },
        "clean_passed": {
          "title": "Clean Passed",
          "type": "integer"
        },
        "clean_scored": {
          "title": "Clean Scored",
          "type": "integer"
        },
        "controls_excluded": {
          "title": "Controls Excluded",
          "type": "integer"
        },
        "execution_errors": {
          "title": "Execution Errors",
          "type": "integer"
        },
        "mean_reward": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Mean Reward"
        },
        "pass_rate_attempted": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Pass Rate Attempted"
        },
        "pass_rate_clean": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Pass Rate Clean"
        },
        "pass_rate_scored": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Pass Rate Scored"
        },
        "passed": {
          "title": "Passed",
          "type": "integer"
        },
        "scored": {
          "title": "Scored",
          "type": "integer"
        },
        "unscored": {
          "title": "Unscored",
          "type": "integer"
        }
      },
      "required": [
        "attempted",
        "scored",
        "assessment_errors",
        "unscored",
        "execution_errors",
        "passed",
        "mean_reward",
        "pass_rate_scored",
        "pass_rate_attempted",
        "clean_scored",
        "clean_passed",
        "pass_rate_clean",
        "controls_excluded"
      ],
      "title": "DenominatorsExport",
      "type": "object"
    },
    "EvidenceRefExport": {
      "additionalProperties": false,
      "properties": {
        "area": {
          "description": "the reviewer's /evidence mount: the trial folder, the task, or the solver's final workspace",
          "enum": [
            "trial",
            "task",
            "workspace"
          ],
          "title": "Area",
          "type": "string"
        },
        "line": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line"
        },
        "path": {
          "description": "relative to that area",
          "title": "Path",
          "type": "string"
        }
      },
      "required": [
        "area",
        "path"
      ],
      "title": "EvidenceRefExport",
      "type": "object"
    },
    "ForkExport": {
      "additionalProperties": false,
      "properties": {
        "children": {
          "items": {
            "$ref": "#/$defs/BranchChildExport"
          },
          "title": "Children",
          "type": "array"
        },
        "cost": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "tokens, usd, usd_known, wall, parent, children, sandbox seconds",
          "title": "Cost"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "default": "fork",
          "description": "fork, or retry (a retry from a checkpoint)",
          "title": "Kind",
          "type": "string"
        },
        "parent_node": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Node"
        },
        "parent_restore": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Parent Restore"
        },
        "snapshot": {
          "additionalProperties": true,
          "title": "Snapshot",
          "type": "object"
        },
        "status": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Status"
        },
        "timing_sec": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Timing Sec"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "V(checkpoint): mean child reward",
          "title": "Value"
        }
      },
      "required": [
        "id",
        "status",
        "parent_restore",
        "children"
      ],
      "title": "ForkExport",
      "type": "object"
    },
    "GroupExport": {
      "additionalProperties": false,
      "properties": {
        "agent": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Agent"
        },
        "denominators": {
          "$ref": "#/$defs/DenominatorsExport"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Model"
        }
      },
      "required": [
        "agent",
        "model",
        "denominators"
      ],
      "title": "GroupExport",
      "type": "object"
    },
    "InterruptedExport": {
      "additionalProperties": false,
      "properties": {
        "agent": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Agent"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Model"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sandbox_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "set when a sandbox was created; it may not have been deleted",
          "title": "Sandbox Id"
        },
        "started_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Started At"
        },
        "task_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "from the attempt's task_path",
          "title": "Task Name"
        }
      },
      "required": [
        "path",
        "task_name",
        "agent",
        "model",
        "started_at",
        "sandbox_id"
      ],
      "title": "InterruptedExport",
      "type": "object"
    },
    "ReviewCriterionExport": {
      "additionalProperties": false,
      "properties": {
        "blocker": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Blocker"
        },
        "explanation": {
          "title": "Explanation",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "outcome": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Outcome"
        },
        "score": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Score"
        },
        "weight": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Weight"
        }
      },
      "required": [
        "name",
        "blocker",
        "weight",
        "outcome",
        "score",
        "explanation"
      ],
      "title": "ReviewCriterionExport",
      "type": "object"
    },
    "ReviewExport": {
      "additionalProperties": false,
      "properties": {
        "criteria": {
          "items": {
            "$ref": "#/$defs/ReviewCriterionExport"
          },
          "title": "Criteria",
          "type": "array"
        },
        "review_valid": {
          "title": "Review Valid",
          "type": "boolean"
        },
        "reviewer_model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reviewer Model"
        },
        "scoring": {
          "additionalProperties": true,
          "title": "Scoring",
          "type": "object"
        },
        "source": {
          "description": "the review_report.json it came from",
          "title": "Source",
          "type": "string"
        },
        "summary": {
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "reviewer_model",
        "review_valid",
        "scoring",
        "summary",
        "criteria",
        "source"
      ],
      "title": "ReviewExport",
      "type": "object"
    },
    "RubricCriterionDefinitionExport": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "null when only the criterion names were recorded",
          "title": "Description"
        },
        "guidance": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Guidance"
        },
        "kind": {
          "description": "blocker: a pass/fail gate; scored: 0-2 times its weight; legacy: a v0.1 pass/fail/not_applicable criterion",
          "enum": [
            "blocker",
            "scored",
            "legacy"
          ],
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "scale": {
          "description": "the values a verdict can take",
          "items": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              }
            ]
          },
          "title": "Scale",
          "type": "array"
        },
        "weight": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Weight"
        }
      },
      "required": [
        "name",
        "kind",
        "weight",
        "scale"
      ],
      "title": "RubricCriterionDefinitionExport",
      "type": "object"
    },
    "RubricDefinitionExport": {
      "additionalProperties": false,
      "properties": {
        "contract": {
          "description": "v0.2 (blockers and weights) or v0.1",
          "title": "Contract",
          "type": "string"
        },
        "criteria": {
          "items": {
            "$ref": "#/$defs/RubricCriterionDefinitionExport"
          },
          "title": "Criteria",
          "type": "array"
        },
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "the rubric file: relative to the task for revisions",
          "title": "Path"
        },
        "sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "of the rubric file, when recorded",
          "title": "Sha256"
        },
        "snapshot": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "the copy the reviewer used, relative to the trial folder",
          "title": "Snapshot"
        }
      },
      "required": [
        "contract",
        "criteria"
      ],
      "title": "RubricDefinitionExport",
      "type": "object"
    },
    "RubricReviewRecordExport": {
      "additionalProperties": false,
      "properties": {
        "current": {
          "description": "the revision result.json's reward comes from",
          "title": "Current",
          "type": "boolean"
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Error"
        },
        "id": {
          "description": "the scoring attempt, or the audit's report folder",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "description": "revision: automatic scoring (bench eval run with a task rubric, bench eval score), which sets the reward; audit: a detached bench review, which does not",
          "enum": [
            "revision",
            "audit"
          ],
          "title": "Kind",
          "type": "string"
        },
        "notes": {
          "items": {
            "type": "string"
          },
          "title": "Notes",
          "type": "array"
        },
        "recorded_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Recorded At"
        },
        "review_valid": {
          "title": "Review Valid",
          "type": "boolean"
        },
        "reviewer": {
          "$ref": "#/$defs/RubricReviewerExport"
        },
        "reward": {
          "$ref": "#/$defs/RubricRewardExport"
        },
        "rubric": {
          "anyOf": [
            {
              "$ref": "#/$defs/RubricDefinitionExport"
            },
            {
              "type": "null"
            }
          ]
        },
        "source": {
          "description": "scoring/<attempt>.json in the trial, or the review_report.json",
          "title": "Source",
          "type": "string"
        },
        "status": {
          "enum": [
            "complete",
            "error"
          ],
          "title": "Status",
          "type": "string"
        },
        "summary": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Summary"
        },
        "verdicts": {
          "items": {
            "$ref": "#/$defs/RubricVerdictExport"
          },
          "title": "Verdicts",
          "type": "array"
        }
      },
      "required": [
        "kind",
        "id",
        "source",
        "current",
        "recorded_at",
        "status",
        "error",
        "review_valid",
        "summary",
        "reviewer",
        "rubric",
        "verdicts",
        "reward",
        "notes"
      ],
      "title": "RubricReviewRecordExport",
      "type": "object"
    },
    "RubricReviewerExport": {
      "additionalProperties": false,
      "properties": {
        "agent": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Agent"
        },
        "environment": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Environment"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Model"
        },
        "reasoning_effort": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "null when not recorded",
          "title": "Reasoning Effort"
        },
        "run": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "the reviewer's own run folder (its trajectory): relative to the trial folder for revisions, as recorded for audits",
          "title": "Run"
        }
      },
      "required": [
        "agent",
        "model",
        "reasoning_effort",
        "environment",
        "run"
      ],
      "title": "RubricReviewerExport",
      "type": "object"
    },
    "RubricRewardExport": {
      "additionalProperties": false,
      "properties": {
        "all_blockers_pass": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "All Blockers Pass"
        },
        "decision": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "publishable / presentable_with_revisions / not_publishable",
          "title": "Decision"
        },
        "failed_blockers": {
          "items": {
            "type": "string"
          },
          "title": "Failed Blockers",
          "type": "array"
        },
        "formula": {
          "description": "the arithmetic, with this review's numbers",
          "title": "Formula",
          "type": "string"
        },
        "gated_quality": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "rubric_reward when tests and every blocker pass, else 0",
          "title": "Gated Quality"
        },
        "max_weighted_points": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Max Weighted Points"
        },
        "passed": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Passed"
        },
        "policy": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Policy"
        },
        "reward": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "the trial reward this review sets; null for audits and incomplete revisions",
          "title": "Reward"
        },
        "rubric_reward": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "weighted_points / max_weighted_points (raw quality)",
          "title": "Rubric Reward"
        },
        "tests_pass": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Tests Pass"
        },
        "verifier_reward": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "the test script's reward",
          "title": "Verifier Reward"
        },
        "weighted_points": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Weighted Points"
        }
      },
      "required": [
        "policy",
        "tests_pass",
        "all_blockers_pass",
        "failed_blockers",
        "weighted_points",
        "max_weighted_points",
        "rubric_reward",
        "gated_quality",
        "decision",
        "verifier_reward",
        "passed",
        "reward",
        "formula"
      ],
      "title": "RubricRewardExport",
      "type": "object"
    },
    "RubricVerdictExport": {
      "additionalProperties": false,
      "properties": {
        "evidence": {
          "description": "the evidence files the explanation cites",
          "items": {
            "$ref": "#/$defs/EvidenceRefExport"
          },
          "title": "Evidence",
          "type": "array"
        },
        "explanation": {
          "description": "the reviewer's reasoning, in full",
          "title": "Explanation",
          "type": "string"
        },
        "kind": {
          "enum": [
            "blocker",
            "scored",
            "legacy"
          ],
          "title": "Kind",
          "type": "string"
        },
        "max_points": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "2 x weight; null for blockers",
          "title": "Max Points"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "outcome": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "pass / fail (/ not_applicable)",
          "title": "Outcome"
        },
        "points": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
