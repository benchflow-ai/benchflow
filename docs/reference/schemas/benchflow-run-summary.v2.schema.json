{
  "$defs": {
    "GateExport": {
      "properties": {
        "fail_on": {
          "description": "--fail-on kinds",
          "items": {
            "type": "string"
          },
          "title": "Fail On",
          "type": "array"
        },
        "fail_under": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "--fail-under, a pass rate",
          "title": "Fail Under"
        },
        "failed": {
          "description": "one line per failed gate check",
          "items": {
            "type": "string"
          },
          "title": "Failed",
          "type": "array"
        }
      },
      "title": "GateExport",
      "type": "object"
    }
  },
  "$id": "https://benchflow.ai/schemas/benchflow-run-summary.v2.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "The result of one ``bench eval run`` (``--summary-out``), for CI.",
  "properties": {
    "budget": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "summary.json's budget block when the job had a budget cap (caps, spent, stopped, reason, cancelled, not_started)",
      "title": "Budget"
    },
    "errored": {
      "title": "Errored",
      "type": "integer"
    },
    "exit_code": {
      "description": "the process exit code of the run",
      "title": "Exit Code",
      "type": "integer"
    },
    "failed": {
      "title": "Failed",
      "type": "integer"
    },
    "gate": {
      "$ref": "#/$defs/GateExport"
    },
    "interrupted": {
      "default": 0,
      "description": "of not_run, the tasks whose trial had started when it stopped",
      "title": "Interrupted",
      "type": "integer"
    },
    "job_dir": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Job Dir"
    },
    "job_name": {
      "title": "Job Name",
      "type": "string"
    },
    "kind": {
      "const": "benchflow.run-summary",
      "default": "benchflow.run-summary",
      "title": "Kind",
      "type": "string"
    },
    "mean_reward": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "description": "over every trial, an unscored one counting 0 (2.0)",
      "title": "Mean Reward"
    },
    "mean_reward_scored_only": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "over scored trials only, as mean_reward was in 1.x (2.0)",
      "title": "Mean Reward Scored Only"
    },
    "not_run": {
      "default": 0,
      "description": "planned tasks a budget, a usage limit or a stop kept from finishing; not in total, counted as not passed by --fail-under",
      "title": "Not Run",
      "type": "integer"
    },
    "pass_rate": {
      "description": "passed / total",
      "title": "Pass Rate",
      "type": "number"
    },
    "passed": {
      "title": "Passed",
      "type": "integer"
    },
    "ran": {
      "description": "tasks run by this invocation",
      "title": "Ran",
      "type": "integer"
    },
    "reused": {
      "description": "finished tasks reused from an earlier run (resume)",
      "title": "Reused",
      "type": "integer"
    },
    "schema_version": {
      "const": 2,
      "default": 2,
      "title": "Schema Version",
      "type": "integer"
    },
    "stopped": {
      "default": false,
      "description": "the run was stopped (Ctrl-C, SIGTERM): the counts are over the trials that finished first, and no gate was applied",
      "title": "Stopped",
      "type": "boolean"
    },
    "timed_out": {
      "description": "trials whose agent timed out (scored or not)",
      "title": "Timed Out",
      "type": "integer"
    },
    "total": {
      "title": "Total",
      "type": "integer"
    },
    "verifier_errored": {
      "title": "Verifier Errored",
      "type": "integer"
    }
  },
  "required": [
    "job_dir",
    "job_name",
    "total",
    "passed",
    "failed",
    "errored",
    "verifier_errored",
    "timed_out",
    "pass_rate",
    "mean_reward",
    "reused",
    "ran",
    "gate",
    "exit_code"
  ],
  "title": "RunSummaryExport",
  "type": "object"
}
