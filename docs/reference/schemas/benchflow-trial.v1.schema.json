  "$id": "https://benchflow.ai/schemas/benchflow-trial.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "agent": {
      "title": "Agent",
      "type": "string"
    },
    "agent_name": {
      "title": "Agent Name",
      "type": "string"
    },
    "assessment": {
      "enum": [
        "scored",
        "error",
        "unscored"
      ],
      "title": "Assessment",
      "type": "string"
    },
    "checkpoints": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Checkpoints",
      "type": "array"
    },
    "control": {
      "anyOf": [
        {
          "enum": [
            "oracle",
            "empty"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "description": "control runs check the task, not an agent",
      "title": "Control"
    },
    "duration_sec": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "title": "Duration Sec"
    },
    "error": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Error"
    },
    "error_category": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Error Category"
    },
    "execution": {
      "description": "integration_failed (1.2): the agent did nothing because its integration broke; see integration_failure",
      "enum": [
        "completed",
        "errored",
        "timed_out",
        "integration_failed"
      ],
      "title": "Execution",
      "type": "string"
    },
    "finished_at": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Finished At"
    },
    "forks": {
      "items": {
        "$ref": "#/$defs/ForkExport"
      },
      "title": "Forks",
      "type": "array"
    },
    "integration_failure": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "why the agent did nothing useful when its integration broke: cause (agent_auth, agent_install, truncated_trajectory, empty_trajectory, immediate_exit, no_activity), evidence, evidence_source, activity counts, reward_withheld; detected: 'on read' for results written before 1.2 (1.2)",
      "title": "Integration Failure"
    },
    "kind": {
      "const": "benchflow.trial",
      "default": "benchflow.trial",
      "title": "Kind",
      "type": "string"
    },
    "model": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Model"
    },
    "n_prompts": {
      "title": "N Prompts",
      "type": "integer"
    },
    "n_tool_calls": {
      "title": "N Tool Calls",
      "type": "integer"
    },
    "passed": {
      "title": "Passed",
      "type": "boolean"
    },
    "path": {
      "description": "trial folder, or the results.jsonl file",
      "title": "Path",
      "type": "string"
    },
    "review": {
      "anyOf": [
        {
          "$ref": "#/$defs/ReviewExport"
        },
        {
          "type": "null"
        }
      ]
    },
    "reward": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "description": "rewards.reward; null when unscored",
      "title": "Reward"
    },
    "rewards": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "title": "Rewards"
    },
    "rollout_name": {
      "title": "Rollout Name",
      "type": "string"
    },
    "row": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "row index for a results.jsonl trial",
      "title": "Row"
    },
    "rubric_reviews": {
      "description": "every rubric review of the trial: scoring revisions oldest first, then detached audits (added in 1.1)",
      "items": {
        "$ref": "#/$defs/RubricReviewRecordExport"
      },
      "title": "Rubric Reviews",
      "type": "array"
    },
    "sandbox": {
      "anyOf": [
        {
          "$ref": "#/$defs/SandboxExport"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "sandbox.json, written when the sandbox was created (1.1)"
    },
    "schema_minor": {
      "default": 2,
      "description": "optional fields added within schema_version; see the changelog",
      "title": "Schema Minor",
      "type": "integer"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "score_outcome": {
      "enum": [
        "passed",
        "failed",
        "errored",
        "verifier_errored"
      ],
      "title": "Score Outcome",
      "type": "string"
    },
    "scoring": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "the automatic reviewer's gate verdict",
      "title": "Scoring"
    },
    "settings": {
      "additionalProperties": true,
      "description": "what bf.compare checks; see SETTINGS",
      "title": "Settings",
      "type": "object"
    },
    "source": {
      "enum": [
        "result.json",
        "results.jsonl"
      ],
      "title": "Source",
      "type": "string"
    },
    "started_at": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "description": "ISO 8601, local time as recorded",
      "title": "Started At"
    },
    "task_name": {
      "title": "Task Name",
      "type": "string"
    },
    "timing": {
      "additionalProperties": true,
      "title": "Timing",
      "type": "object"
    },
    "trajectory": {
      "anyOf": [
        {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "ACP events; null when not included in the export",
      "title": "Trajectory"
    },
    "usage": {
      "$ref": "#/$defs/UsageExport"
    },
    "verifier": {
      "anyOf": [
        {
          "$ref": "#/$defs/VerifierExport"
        },
        {
          "type": "null"
        }
      ]
    },
    "verifier_error": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Verifier Error"
    },
    "verifier_error_category": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Verifier Error Category"
    }
  },
  "required": [
    "source",
    "path",
    "task_name",
    "rollout_name",
    "agent",
    "agent_name",
    "model",
    "reward",
    "rewards",
    "passed",
    "score_outcome",
    "execution",
    "assessment",
    "control",
    "error",
    "error_category",
    "verifier_error",
    "verifier_error_category",
    "n_tool_calls",
    "n_prompts",
    "usage",
    "started_at",
    "finished_at",
    "duration_sec",
    "timing",
    "settings",
    "forks",
    "checkpoints",
    "verifier",
    "review"
  ],
  "title": "TrialExport",
  "type": "object"
}
