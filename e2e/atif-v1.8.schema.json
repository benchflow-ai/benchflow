{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://benchflow.ai/schemas/atif-v1.8.json",
  "title": "ATIF v1.8 trajectory, as BenchFlow writes trainer/atif.json",
  "description": "Agent Trajectory Interchange Format v1.8. Derived from the format's specification and checked against its reference models on every ATIF document of a Terminal-Bench 2 comparison (2026-10-11). JSON Schema cannot express the rest of the format's rules; e2e/run.py checks those too: step_id counts 1, 2, 3...; fields only an agent step may carry; observation results refer to a tool call of their own step; cached tokens are part of prompt tokens; final_metrics.total_steps equals the step count; embedded subagents have unique trajectory_ids.",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "ATIF-v1.8"
    },
    "session_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "trajectory_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "agent": {
      "$ref": "#/$defs/Agent"
    },
    "steps": {
      "items": {
        "$ref": "#/$defs/Step"
      },
      "minItems": 1,
      "type": "array"
    },
    "notes": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "final_metrics": {
      "anyOf": [
        {
          "$ref": "#/$defs/FinalMetrics"
        },
        {
          "type": "null"
        }
      ]
    },
    "continued_trajectory_ref": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "extra": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "subagent_trajectories": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Subagent"
          }
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "agent",
    "steps"
  ],
  "type": "object",
  "$defs": {
    "Agent": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "model_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "tool_definitions": {
          "anyOf": [
            {
              "items": {
                "additionalProperties": true,
                "type": "object"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ]
        },
        "extra": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "name",
        "version"
      ],
      "type": "object"
    },
    "AudioSource": {
      "additionalProperties": false,
      "properties": {
        "media_type": {
          "enum": [
            "audio/wav",
            "audio/mpeg",
            "audio/mp4",
            "audio/aac",
            "audio/ogg",
            "audio/flac",
            "audio/webm",
            "audio/aiff"
          ],
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "duration_sec": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "media_type",
        "path"
      ],
      "type": "object"
    },
    "ContentPart": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "text",
            "image",
            "audio"
          ],
          "type": "string"
        },
        "text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "source": {
          "anyOf": [
            {
              "$ref": "#/$defs/ImageSource"
            },
            {
              "$ref": "#/$defs/AudioSource"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "type"
      ],
      "type": "object"
    },
    "FinalMetrics": {
      "additionalProperties": false,
      "properties": {
        "total_prompt_tokens": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "total_completion_tokens": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "total_cached_tokens": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "total_cost_usd": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "total_steps": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "extra": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "type": "object"
    },
    "ImageSource": {
      "additionalProperties": false,
      "properties": {
        "media_type": {
          "enum": [
            "image/jpeg",
            "image/png",
            "image/gif",
            "image/webp"
          ],
          "type": "string"
        },
        "path": {
          "type": "string"
        }
      },
      "required": [
        "media_type",
        "path"
      ],
      "type": "object"
    },
    "Metrics": {
      "additionalProperties": false,
      "properties": {
        "prompt_tokens": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "completion_tokens": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "cached_tokens": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "cost_usd": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "prompt_token_ids": {
          "anyOf": [
            {
              "items": {
                "type": "integer"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ]
        },
        "completion_token_ids": {
          "anyOf": [
            {
              "items": {
                "type": "integer"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ]
        },
        "logprobs": {
          "anyOf": [
            {
              "items": {
                "type": "number"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ]
        },
        "extra": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "type": "object"
    },
    "Observation": {
      "additionalProperties": false,
      "properties": {
        "results": {
          "items": {
            "$ref": "#/$defs/ObservationResult"
          },
          "type": "array"
        }
      },
      "required": [
        "results"
      ],
      "type": "object"
    },
    "ObservationResult": {
      "additionalProperties": false,
      "properties": {
        "source_call_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "content": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "items": {
                "$ref": "#/$defs/ContentPart"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ]
        },
        "subagent_trajectory_ref": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/SubagentTrajectoryRef"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ]
        },
        "extra": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "type": "object"
    },
    "Step": {
      "additionalProperties": false,
      "properties": {
        "step_id": {
          "minimum": 1,
          "type": "integer"
        },
        "timestamp": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "source": {
          "enum": [
            "system",
            "user",
            "agent"
          ],
          "type": "string"
        },
        "model_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "reasoning_effort": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "message": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "items": {
                "$ref": "#/$defs/ContentPart"
              },
              "type": "array"
            }
          ]
        },
        "reasoning_content": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "tool_calls": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/ToolCall"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ]
        },
        "observation": {
          "anyOf": [
            {
              "$ref": "#/$defs/Observation"
            },
            {
              "type": "null"
            }
          ]
        },
        "metrics": {
          "anyOf": [
            {
              "$ref": "#/$defs/Metrics"
            },
            {
              "type": "null"
            }
          ]
        },
        "is_copied_context": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "llm_call_count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "extra": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "step_id",
        "source",
        "message"
      ],
      "type": "object"
    },
    "SubagentTrajectoryRef": {
      "additionalProperties": false,
      "properties": {
        "trajectory_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "session_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "trajectory_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "extra": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "type": "object"
    },
    "ToolCall": {
      "additionalProperties": false,
      "properties": {
        "tool_call_id": {
          "type": "string"
        },
        "function_name": {
          "type": "string"
        },
        "arguments": {
          "additionalProperties": true,
          "type": "object"
        },
        "extra": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "tool_call_id",
        "function_name",
        "arguments"
      ],
      "type": "object"
    },
    "Subagent": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "type": "string",
          "pattern": "^ATIF-v1\\.[0-8]$"
        },
        "session_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "trajectory_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "agent": {
          "$ref": "#/$defs/Agent"
        },
        "steps": {
          "items": {
            "$ref": "#/$defs/Step"
          },
          "minItems": 1,
          "type": "array"
        },
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "final_metrics": {
          "anyOf": [
            {
              "$ref": "#/$defs/FinalMetrics"
            },
            {
              "type": "null"
            }
          ]
        },
        "continued_trajectory_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "extra": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ]
        },
        "subagent_trajectories": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Subagent"
              }
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "agent",
        "steps"
      ],
      "type": "object"
    }
  }
}
