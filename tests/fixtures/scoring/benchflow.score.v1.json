{
  "rule": "benchflow.score.v1",
  "about": "Trial outcomes and the figures the scoring rule benchflow.score.v1 gives them. A reader that counts the same way reproduces every case's expected figures, exactly for the counts and within tolerance for the real numbers. Each trial has its task (the interval's cluster), its outcome, who ended it when it has no score (ending: provider, harness or null), and whether it ran out of time or met a rate limit; a trial with a result also gives the result.json fields BenchFlow reads them from. See docs/reference/scoring-rule.md.",
  "outcomes": {
    "passed": "scored and passed: reward 1, or the rubric review's pass verdict (counts 1)",
    "failed": "scored below a pass (counts 0)",
    "refused": "no score because of something the agent can cause: the plugin guard refused a pytest plugin, or the final verify found no usable reward (counts 0; kept in the error-excluding figure as a failure)",
    "errored": "no score: the agent, its sandbox or its model provider errored, or BenchFlow's time limits ended it (counts 0; left out of the error-excluding figure)",
    "verifier_errored": "no score: the verifier failed (counts 0; left out of the error-excluding figure)",
    "no_verdict": "no score and no recorded error, such as an assessment still pending (counts 0; left out of the error-excluding figure)"
  },
  "endings": {
    "provider": "the model provider ended a trial with no score: its API failed, it rate-limited the run, it refused the credential or the request, or the login's usage limit ran out",
    "harness": "BenchFlow's own limits ended a trial with no score: its time limit, or the idle watchdog"
  },
  "interval": "95% interval over tasks: Wilson's score interval over the trials with one trial per task or one task (wilson); else Wilson's interval on the effective sample size n / max(1, se^2 / (p(1-p)/n)), with se the cluster-robust standard error over tasks (factor T/(T-1)), or on the number of tasks when every trial passed or none did (wilson-clustered). z = 1.96.",
  "tolerance": 1e-09,
